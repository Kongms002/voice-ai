# Keep the FastAPI process on the GPU machine. Set a long random token in production.
TTS_API_KEY=replace-with-a-long-random-token
VOICE_PROFILE_DIR=/srv/voiceme-ai/voices

# Temporary wiring test only. Disable before connecting an actual model.
DEMO_TTS=false

# Recommended 16GB-VRAM path: run GPT-SoVITS api_v2.py on the same GPU host.
# The voiceme FastAPI service will call POST /tts locally, never exposing it to the internet.
GPT_SOVITS_URL=http://127.0.0.1:9880

# Replace this with the CLI wrapper for your selected GPU voice model.
# Available placeholders: {reference_audio} {text_file} {output_file} {speed} {pitch}
# TTS_COMMAND_TEMPLATE=/opt/voice/run_tts.sh --reference {reference_audio} --text-file {text_file} --output {output_file} --speed {speed} --pitch {pitch}
TTS_OUTPUT_EXTENSION=mp3
MAX_BATCH_ITEMS=120
